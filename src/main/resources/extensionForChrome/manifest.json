{
  "manifest_version": 3,
  "name": "URL Button Extension",
  "version": "1.0",
  "description": "Додає кнопку біля URL-адрес на сторінці",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}